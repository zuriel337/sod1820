-- C: previous ACLs: research_level_of {postgres,anon,authenticated}; fn_cohort_acceptance / fn_metatron_gaps {PUBLIC,postgres}
revoke execute on function public.research_level_of(uuid) from service_role;
grant execute on function public.research_level_of(uuid) to anon, authenticated;
revoke execute on function public.fn_cohort_acceptance(text) from service_role;
grant execute on function public.fn_cohort_acceptance(text) to public;
revoke execute on function public.fn_metatron_gaps() from service_role;
grant execute on function public.fn_metatron_gaps() to public;
revoke execute on function public.fn_metatron_status() from service_role;
grant execute on function public.fn_metatron_status() to public;
revoke execute on function public.admin_ai_usage(integer) from service_role;
grant execute on function public.admin_ai_usage(integer) to public,authenticated;
revoke execute on function public.admin_ambassadors(integer) from service_role;
grant execute on function public.admin_ambassadors(integer) to public,authenticated;
revoke execute on function public.admin_journey_shares(integer) from service_role;
grant execute on function public.admin_journey_shares(integer) to public,authenticated;
revoke execute on function public.admin_research_usage(integer) from service_role;
grant execute on function public.admin_research_usage(integer) to public,authenticated;
revoke execute on function public.arrival_sources(integer) from service_role;
grant execute on function public.arrival_sources(integer) to authenticated;
revoke execute on function public.audience_dim5_vs_orgeula(integer) from service_role;
grant execute on function public.audience_dim5_vs_orgeula(integer) to public;
revoke execute on function public.audience_overlap_report(integer) from service_role;
grant execute on function public.audience_overlap_report(integer) to public,authenticated;
revoke execute on function public.community_share_count() from service_role;
grant execute on function public.community_share_count() to public,anon,authenticated;
revoke execute on function public.els_analytics(integer) from service_role;
grant execute on function public.els_analytics(integer) to authenticated;
revoke execute on function public.viral_report() from service_role;
grant execute on function public.viral_report() to public,anon,authenticated;
commit;
