-- C: previous ACLs: research_level_of {postgres,anon,authenticated}; fn_cohort_acceptance / fn_metatron_gaps {PUBLIC,postgres}
revoke execute on function public.research_level_of(uuid) from service_role;
grant execute on function public.research_level_of(uuid) to anon, authenticated;
revoke execute on function public.fn_cohort_acceptance(text) from service_role;
grant execute on function public.fn_cohort_acceptance(text) to public;
revoke execute on function public.fn_metatron_gaps() from service_role;
grant execute on function public.fn_metatron_gaps() to public;
commit;
