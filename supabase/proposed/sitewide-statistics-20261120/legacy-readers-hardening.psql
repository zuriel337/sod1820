-- PROPOSAL ONLY (#1461 acceptance review, 20.11.2026). Not wired into apply.psql.
-- Order: run only AFTER apply.psql (needs public.fn_ti_public_word_eligible).
-- Requires an explicit ZURIEL approval for this exact file/SHA (CLAUDE.md 0.4).
-- Closes anon/authenticated access to legacy SECURITY DEFINER readers that return
-- hidden phrases or per-number search statistics below any privacy floor.
\set ON_ERROR_STOP on
begin;
do $$ begin
 if to_regprocedure('public.fn_ti_public_word_eligible(uuid)') is null then raise exception 'apply.psql must run first'; end if;
 if md5(pg_get_functiondef('public.fn_raziel_research_intel(integer,text,integer)'::regprocedure)) <> '1b6215ef43e1c794caaca2195c5aa235' then raise exception 'preimage drift: fn_raziel_research_intel'; end if;
 if md5(pg_get_functiondef('public.number_cross_resonance(text,jsonb,integer)'::regprocedure)) <> '10e65227bef491d351cadaa68a28b86c' then raise exception 'preimage drift: number_cross_resonance'; end if;
 if md5(pg_get_functiondef('public.fn_name_research(text)'::regprocedure)) <> 'd2202e7f66cd26f99e6acec0a2b0f7a6' then raise exception 'preimage drift: fn_name_research'; end if;
 if md5(pg_get_functiondef('public.reality_scan(integer,integer)'::regprocedure)) <> '7a9167fae01d7ea323e7ac8e035538eb' then raise exception 'preimage drift: reality_scan'; end if;
 if md5(pg_get_functiondef('public.fn_name_research_stats(integer)'::regprocedure)) <> '398d155905f791c76fd0614b1d6d5751' then raise exception 'preimage drift: fn_name_research_stats'; end if;
end $$;
-- Still used by the 2029 client (supabaseApi2029.js number_cross_resonance): filter, keep grants.
\ir number_cross_resonance.after.sql
-- Re-exposed to anon through fn_raziel_research_intel_scoped (always returns v_public):
-- the floor must live in the base reader; direct calls become server-only.
\ir fn_raziel_research_intel.after.sql
revoke execute on function public.fn_raziel_research_intel(integer,text,integer) from public,anon,authenticated;
grant execute on function public.fn_raziel_research_intel(integer,text,integer) to service_role;
-- No 2029 client, Edge Function or SQL caller found (repo grep + pg_proc scan, 20.11.2026):
-- server-only instead of rewriting their owner semantics.
--   fn_name_research: verified-but-unpublished/encrypted/tier<0 phrases (live: 115 rows).
--   reality_scan: axis includes unverified/unpublished phrases (live: 397 hidden phrases).
--   fn_name_research_stats: per-window counts of private name searches, no floor.
revoke execute on function public.fn_name_research(text) from public,anon,authenticated;
revoke execute on function public.reality_scan(integer,integer) from public,anon,authenticated;
revoke execute on function public.fn_name_research_stats(integer) from public,anon,authenticated;
grant execute on function public.fn_name_research(text),public.reality_scan(integer,integer),public.fn_name_research_stats(integer) to service_role;
commit;
