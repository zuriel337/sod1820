-- PROPOSAL ONLY (/stats + section strips, ZURIEL 21.11.2026). Requires explicit ZURIEL approval for the exact SHA (CLAUDE.md 0.4).
-- Extends the existing TI producer fn_ti_activity_pulse2029 (v2 cache key). Grants unchanged (CREATE OR REPLACE);
-- the public wrapper research_pulse_2029 is not touched. Revert: rollback.psql (exact live preimage).
\set ON_ERROR_STOP on
begin;
do $pre$ begin
  if md5(pg_get_functiondef('public.fn_ti_activity_pulse2029(integer)'::regprocedure)) <> '478b49a442419f2fd5528fa480f835cb' then
    raise exception 'preimage drift: fn_ti_activity_pulse2029';
  end if;
  if to_regclass('public.crawl_daily') is null or to_regclass('public.research_contributions') is null then
    raise exception 'statistics-sections: source table missing';
  end if;
  if has_function_privilege('anon','public.fn_ti_activity_pulse2029(integer)','execute') then
    raise exception 'statistics-sections: producer must stay server-only';
  end if;
end $pre$;
\ir fn_ti_activity_pulse2029.after.sql
;
do $post$ begin
  if has_function_privilege('anon','public.fn_ti_activity_pulse2029(integer)','execute')
     or not has_function_privilege('anon','public.research_pulse_2029(integer)','execute') then
    raise exception 'statistics-sections: grant drift after apply';
  end if;
end $post$;
commit;
