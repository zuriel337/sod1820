[{"r":46,"letters":"יאנינאמיהוהאמלאכאשרדברתמבאזניכנאעשהלכמבמדברהזהיפלופגריכמוכלפק"},{"r":47,"letters":"דבראתכלהדברימהאלהותבקעהאדמהאשרתחתיהמותפתחהארצאתפיהותבלעאתמואת"},{"r":48,"letters":"באובמתאובעצמאדמאובקבריטמאשבעתימימולקחולטמאמעפרשרפתהחטאתונתנעל"},{"r":49,"letters":"אואלבלקויאמרומאנבלעמהלכעמנוויספעודבלקשלחשרימרבימונכבדיממאלהוי"},{"r":50,"letters":"אתשניהמאתאישישראלואתהאשהאלקבתהותעצרהמגפהמעלבניישראלויהיוהמתימ"},{"r":51,"letters":"האתוויקחאתיהושעויעמדהולפניאלעזרהכהנולפניכלהעדהויסמכאתידיועליו"},{"r":52,"letters":"התרועהבידוויצבאועלמדינכאשרצוהיהוהאתמשהויהרגוכלזכרואתמלכימדינה"},{"r":53,"letters":"כתבמשהאתמוצאיהמלמסעיהמעלפייהוהואלהמסעיהמלמוצאיהמויסעומרעמססבח"},{"r":54,"letters":"ישובהרצחאלארצאחזתווהיואלהלכמלחקתמשפטלדרתיכמבכלמושבתיכמכלמכהנפ"},{"r":55,"letters":"המלחמהמקרבהמחנהכאשרנשבעיהוהלהמוגמידיהוההיתהבמלהמממקרבהמחנהעדת"},{"r":56,"letters":"יהוהאלהיככייהוהאלהיכאשאכלההואאלקנאכיתולידבנימובניבנימונושנתמב"},{"r":57,"letters":"ארצאשרנשבעלאבתינוויצונויהוהלעשותאתכלהחקימהאלהליראהאתיהוהאלהינ"},{"r":58,"letters":"לוולאשמעתמבקלוממרימהייתמעמיהוהמיומדעתיאתכמואתנפללפנייהוהאתארב"},{"r":59,"letters":"ימצוכרקבכלאותנפשכתזבחואכלתבשרכברכתיהוהאלהיכאשרנתנלכבכלשעריכהט"},{"r":60,"letters":"להיכתתנלווזכרתכיעבדהייתבארצמצרימויפדכיהוהאלהיכעלכנאנכימצוכאתה"},{"r":61,"letters":"אאתרעהוומתהואינוסאלאחתהערימהאלהוחיפנירדפגאלהדמאחריהרצחכייחמלב"},{"r":62,"letters":"בעמהאשהוהאשהובערתהרעמישראלכייהיהנערבתולהמארשהלאישומצאהאישבעיר"},{"r":63,"letters":"היכולביתכאתהוהלויוהגראשרבקרבככיתכלהלעשראתכלמעשרתבואתכבשנההשלי"},{"r":64,"letters":"רנתניהוהאלהיכלכואכלתפריבטנכבשרבניכובנתיכאשרנתנלכיהוהאלהיכבמצו"},{"r":65,"letters":"שעויאמראליולעיניכלישראלחזקואמצכיאתהתבואאתהעמהזהאלהארצאשרנשבעי"},{"r":66,"letters":"ורהבאפכוכלילעלמזבחכברכיהוהחילוופעלידיותרצהמחצמתנימקמיוומשנאיו"}]
