[{"r":695,"letters":"קרשהאחדושניאדנימתחתהקרשהאחדולירכתיהמשכנימהעשהששהקרשימושניקרשי"},{"r":696,"letters":"אדנימתחתהקרשהאחדויעשבריחיעצישטימחמשהלקרשיצלעהמשכנהאחתוחמשהברי"},{"r":697,"letters":"יצפאתהבריחמזהבויעשאתהפרכתתכלתוארגמנותולעתשניוששמשזרמעשהחשבעשה"},{"r":698,"letters":"וצפהראשיהמוחשקיהמזהבואדניהמחמשהנחשתויעשבצלאלאתהארנעצישטימאמתי"},{"r":699,"letters":"שניתויעשבדיעצישטימויצפאתמזהבויבאאתהבדימבטבעתעלצלעתהארנלשאתאתה"},{"r":700,"letters":"קצוותוויהיוהכרבימפרשיכנפימלמעלהסככימבכנפיהמעלהכפרתופניהמאישאל"},{"r":701,"letters":"וסביבויצקלוארבעטבעתזהבויתנאתהטבעתעלארבעהפאתאשרלארבערגליולעמתה"},{"r":702,"letters":"כבהנזהבטהורויעשאתהמנרהזהבטהורמקשהעשהאתהמנרהירכהוקנהגביעיהכפתר"},{"r":703,"letters":"רחכנלששתהקנימהיצאיממנהמנרהובמנרהארבעהגבעיממשקדימכפתריהופרחיהו"},{"r":704,"letters":"קחיהומחתתיהזהבטהורככרזהבטהורעשהאתהואתכלכליהויעשאתמזבחהקטרתעצי"},{"r":705,"letters":"לעתיועלשניצדיולבתימלבדימלשאתאתובהמויעשאתהבדימעצישטימויצפאתמזה"},{"r":706,"letters":"תיוויצפאתונחשתויעשאתכלכליהמזבחאתהסירתואתהיעימואתהמזרקתאתהמזלג"},{"r":707,"letters":"חשתויבאאתהבדימבטבעתעלצלעתהמזבחלשאתאתובהמנבובלחתעשהאתוויעשאתהכ"},{"r":708,"letters":"כספולפאתצפונמאהבאמהעמודיהמעשרימואדניהמעשרימנחשתוויהעמודימוחשק"},{"r":709,"letters":"שהולכתפהשניתמזהומזהלשערהחצרקלעימחמשעשרהאמהעמדיהמשלשהואדניהמשל"},{"r":710,"letters":"יוששמשזרועשרימאמהארכוקומהברחבחמשאמותלעמתקלעיהחצרועמדיהמארבעהו"},{"r":711,"letters":"בצלאלבנאוריבנחורלמטהיהודהעשהאתכלאשרצוהיהוהאתמשהואתואהליאבבנאח"},{"r":712,"letters":"קודיהעדהמאתככרואלפושבעמאותוחמשהושבעימשקלבשקלהקדשבקעלגלגלתמחצי"},{"r":713,"letters":"כרככרלאדנואתהאלפושבעהמאותוחמשהושבעימעשהווימלעמודימוצפהראשיהמו"},{"r":714,"letters":"החצרואתכליתדתהמשכנואתכליתדתהחצרסביבומנהתכלתוהארגמנותולעתהשניע"},{"r":715,"letters":"תובתוכהארגמנובתוכתולעתהשניובתוכהששמעשהחשבכתפתעשולוחברתעלשניקצ"}]
