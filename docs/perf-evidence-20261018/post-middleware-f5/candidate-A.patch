+// A browser-class client that labels the request as a top-level document navigation does not wait for the
+// existence lookup on /post/:slug: the 2029 SPA already renders the noindex Not Found page for a missing slug.
+// Everything else (goodbot, ai, unlisted crawlers such as Slurp/Yeti/Qwantify that classify as 'browser' but send no
+// Sec-Fetch metadata, HEAD/GET tools, old browsers) keeps the exact lookup and the real HTTP 404.
+function isHumanDocumentNavigation(request, kind) {
+  return kind === 'browser'
+    && request.headers.get('sec-fetch-mode') === 'navigate'
+    && request.headers.get('sec-fetch-dest') === 'document';
+}
