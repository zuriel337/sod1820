@@ -0,0 +1,101 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { createPublicReadFetch, PUBLIC_READ_TABLES } from '../src/lib/publicReadCache.js';
+
+const ANON = 'anon-key-fixture';
+const URL_POSTS = 'https://x.supabase.co/rest/v1/posts?select=id,slug&limit=3';
+const anonHeaders = () => ({ apikey: ANON, authorization: `Bearer ${ANON}` });
+
+function setup(opts = {}) {
+  const h = { t: 1_000_000, calls: [], status: 200, fail: false, gate: null };
+  const base = async (input, init) => {
+    h.calls.push({ url: String(input), method: init?.method || 'GET', hadSignal: !!init?.signal });
+    if (h.gate) await h.gate;
+    if (h.fail) throw new Error('network');
+    return new Response(JSON.stringify([{ id: h.calls.length }]), { status: h.status, headers: { 'content-type': 'application/json', 'content-range': '0-0/1' } });
+  };
+  h.fetch = createPublicReadFetch({ baseFetch: base, anonKey: ANON, now: () => h.t, ...opts });
+  return h;
+}
