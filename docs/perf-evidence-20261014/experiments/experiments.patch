+import test from "node:test";
+import assert from "node:assert/strict";
+import { createPublicTransport } from "../src/lib/publicReadTransport.js";
+
+const KEY = "anon-key";
+const URL_POSTS = "https://x.supabase.co/rest/v1/posts?select=id&limit=1";
+const hdr = (extra = {}) => new Headers({ apikey: KEY, Authorization: `Bearer ${KEY}`, "x-client-info": "t", "accept-profile": "public", ...extra });
+function harness(opts) {
+  const calls = [];
+  const baseFetch = async (input, init) => { calls.push({ url: typeof input === "string" ? input : input.url, init }); return new Response(JSON.stringify([{ id: 1 }]), { status: 200, headers: { "content-type": "application/json" } }); };
+  return { calls, transport: createPublicTransport({ baseFetch, anonKey: KEY, ...opts }) };
+}
+
+test("noPreflight: anonymous GET moves the public key into the query and sends no custom header", async () => {
+  const { calls, transport } = harness({ noPreflight: true });
+  await transport(URL_POSTS, { method: "GET", headers: hdr() });
+  assert.equal(calls.length, 1);
+  assert.ok(calls[0].url.includes(`apikey=${KEY}`));
+  assert.equal(calls[0].init.headers, undefined);
+});
+
+test("noPreflight never touches a signed-in token, Prefer/Range requests, writes or other schemas", async () => {
+  const { calls, transport } = harness({ noPreflight: true });
+  await transport(URL_POSTS, { method: "GET", headers: hdr({ Authorization: "Bearer user-jwt" }) });
+  await transport(URL_POSTS, { method: "GET", headers: hdr({ Prefer: "count=exact" }) });
+  await transport(URL_POSTS, { method: "GET", headers: hdr({ Range: "0-9" }) });
+  await transport(URL_POSTS, { method: "GET", headers: hdr({ "accept-profile": "private" }) });
+  await transport("https://x.supabase.co/rest/v1/rpc/convergence_meter", { method: "POST", headers: hdr(), body: "{}" });
+  await transport("https://x.supabase.co/auth/v1/user", { method: "GET", headers: hdr() });
+  assert.equal(calls.length, 6);
+  for (const c of calls) assert.ok(!c.url.includes("apikey="), c.url);
+});
+
+test("early: the first matching GET takes the head response once; a different Accept or a failed early read falls through", async () => {
+  globalThis.window = { __sodEarly: new Map() };
+  const key = decodeURIComponent(URL_POSTS);
+  window.__sodEarly.set(key, { accept: "application/json", p: Promise.resolve(new Response('[{"id":9}]', { status: 200 })) });
+  const { calls, transport } = harness({ early: true });
+  const first = await (await transport(URL_POSTS, { method: "GET", headers: hdr() })).json();
+  assert.deepEqual(first, [{ id: 9 }]);
+  assert.equal(calls.length, 0);
+  const second = await (await transport(URL_POSTS, { method: "GET", headers: hdr() })).json();
+  assert.deepEqual(second, [{ id: 1 }]);          // the early entry was consumed once
+  assert.equal(calls.length, 1);
+  window.__sodEarly.set(key, { accept: "application/json", p: Promise.resolve(new Response("x")) });
+  await transport(URL_POSTS, { method: "GET", headers: hdr({ accept: "application/vnd.pgrst.object+json" }) });
+  assert.equal(calls.length, 2);                   // object-mode read does not receive the array response
+  window.__sodEarly.set(key, { accept: "application/json", p: Promise.reject(new Error("net")) });
+  const r = await transport(URL_POSTS, { method: "GET", headers: hdr() });
+  assert.equal(r.status, 200);
+  assert.equal(calls.length, 3);
+  delete globalThis.window;
+});
+
+test("dedupeRpc: identical simultaneous read-only RPCs share one request; other RPCs and bodies do not", async () => {
+  const { calls, transport } = harness({ dedupeRpc: true });
+  const u = "https://x.supabase.co/rest/v1/rpc/convergence_meter";
+  const post = (body, url = u) => transport(url, { method: "POST", headers: hdr({ "content-type": "application/json" }), body });
+  const rs = await Promise.all([post('{"a":1}'), post('{"a":1}'), post('{"a":1}')]);
+  assert.equal(calls.length, 1);
+  for (const r of rs) assert.deepEqual(await r.json(), [{ id: 1 }]);
+  await post('{"a":2}');
+  assert.equal(calls.length, 2);
+  await post("{}", "https://x.supabase.co/rest/v1/rpc/track_visit");
+  await post("{}", "https://x.supabase.co/rest/v1/rpc/track_visit");
+  assert.equal(calls.length, 4);                    // not on the read-only list: never merged
+});
