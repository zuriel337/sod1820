diff --git a/src/lib/publicReadCache.js b/src/lib/publicReadCache.js
new file mode 100644
index 00000000..1e887d85
--- /dev/null
+++ b/src/lib/publicReadCache.js
@@ -0,0 +1,87 @@
+// Anonymous public READ coalescing + short-lived reuse for PostgREST GET requests.
+//
+// Why: every in-app navigation re-sent the whole page data (Home: ~34 requests / ~780 KB, World: ~45 / ~380 KB),
+// including on browser Back, and identical simultaneous reads were sent more than once.
+//
+// Contract (deliberately narrow so access and freshness semantics do not change):
+//  - only GET /rest/v1/<table> for the allowlisted public content tables below; never site_flags, rpc,
+//    storage, auth, or any user/admin table;
+//  - only ANONYMOUS requests (no Authorization header, or Authorization equal to the anon key). A signed-in
+//    user's token is never cached: RLS may personalise the answer;
+//  - simultaneous identical requests share one network request (no TTL involved);
+//  - a successful (200/206) response may be reused for ttlMs (default 30 s) and is then discarded; errors are
+//    never stored; at most maxEntries bodies of at most maxBodyBytes are kept;
+//  - the caller's AbortSignal only rejects that caller; it never cancels the shared request.
+// Public content can therefore be at most ttlMs old on a repeat visit. Locks (site_flags) are always read fresh.
+export const PUBLIC_READ_TTL_MS = 30000;
+export const PUBLIC_READ_TABLES = Object.freeze([
+  "posts", "topic_cards_public", "nodes", "edges", "gallery_images", "galleries", "contributors",
+  "channel_updates", "els_records", "gematria_words", "research_contributions", "research_objects",
+]);
+const ALLOWED = new Set(PUBLIC_READ_TABLES);
+const KEY_HEADERS = ["accept", "accept-profile", "prefer", "range", "range-unit", "apikey"];
+
+function headerMap(init, input) {
+  const h = new Headers(init?.headers || (typeof Request !== "undefined" && input instanceof Request ? input.headers : undefined));
+  return h;
+}
+
+export function createPublicReadFetch({ baseFetch, anonKey, ttlMs = PUBLIC_READ_TTL_MS, maxEntries = 120, maxBodyBytes = 1_500_000, now = Date.now }) {
+  const inflight = new Map();   // key -> Promise<{status,statusText,headers,body}|Response>
+  const done = new Map();       // key -> {at, status, statusText, headers, body}
+  const base = baseFetch || ((...args) => fetch(...args));
+
+  function cacheable(input, init) {
+    const url = typeof input === "string" ? input : input instanceof URL ? input.href : input?.url;
+    const method = String(init?.method || (typeof Request !== "undefined" && input instanceof Request ? input.method : "GET")).toUpperCase();
+    if (method !== "GET" || !url) return null;
+    let u; try { u = new URL(url); } catch { return null; }
+    const m = u.pathname.match(/^\/rest\/v1\/([a-z0-9_]+)$/);
+    if (!m || !ALLOWED.has(m[1])) return null;
+    const h = headerMap(init, input);
+    const auth = h.get("authorization");
+    if (auth && auth !== `Bearer ${anonKey}`) return null;   // signed-in or unknown credential: never cache
+    const key = u.href + "\n" + KEY_HEADERS.map((n) => `${n}=${h.get(n) || ""}`).join("&");
+    return { key, signal: init?.signal || null };
+  }
+
+  const toResponse = (e) => new Response(e.body.byteLength && ![204, 205, 304].includes(e.status) ? e.body.slice(0) : null, { status: e.status, statusText: e.statusText, headers: e.headers });
+  function withAbort(p, signal) {
+    if (!signal) return p;
+    if (signal.aborted) return Promise.reject(new DOMException("Aborted", "AbortError"));
+    return new Promise((resolve, reject) => {
+      const onAbort = () => reject(new DOMException("Aborted", "AbortError"));
+      signal.addEventListener("abort", onAbort, { once: true });
+      p.then((v) => { signal.removeEventListener("abort", onAbort); resolve(v); }, (e) => { signal.removeEventListener("abort", onAbort); reject(e); });
+    });
+  }
+  function evict() {
+    while (done.size > maxEntries) done.delete(done.keys().next().value);
+  }
+
+  function publicReadFetch(input, init) {
+    const c = cacheable(input, init);
+    if (!c) return base(input, init);
+    const hit = done.get(c.key);
+    if (hit) {
+      if (now() - hit.at < ttlMs) return withAbort(Promise.resolve(toResponse(hit)), c.signal);
+      done.delete(c.key);
+    }
+    let shared = inflight.get(c.key);
+    if (!shared) {
+      const { signal, ...rest } = init || {};
+      shared = (async () => {
+        const res = await base(input instanceof Request ? input.url : input, rest);
+        const body = await res.arrayBuffer();
+        const entry = { at: now(), status: res.status, statusText: res.statusText, headers: [...res.headers.entries()], body };
+        if ((res.status === 200 || res.status === 206) && body.byteLength <= maxBodyBytes) { done.set(c.key, entry); evict(); }
+        return entry;
+      })().finally(() => { inflight.delete(c.key); });
+      inflight.set(c.key, shared);
+    }
+    return withAbort(shared.then(toResponse), c.signal);
+  }
+  publicReadFetch.clear = () => { done.clear(); };
+  publicReadFetch.size = () => done.size;
+  return publicReadFetch;
+}
diff --git a/src/lib/publicReadTransport.js b/src/lib/publicReadTransport.js
new file mode 100644
index 00000000..67537aa7
--- /dev/null
+++ b/src/lib/publicReadTransport.js
@@ -0,0 +1,56 @@
+// EXPERIMENT transport under the Supabase client (anonymous public reads only). Three independently switchable behaviours:
+//  noPreflight: an anonymous GET carries the public anon key as the `apikey` query parameter and NO custom headers, so the browser
+//               sends one simple CORS request instead of OPTIONS + GET (each cross-origin URL otherwise costs an extra round trip).
+//  early:       a response started from <head> (window.__sodEarly, see vite.config.js) is handed to the first matching GET.
+//  dedupeRpc:   identical simultaneous POSTs to allow-listed read-only RPCs share one network request.
+// Never touches requests that carry a signed-in token, Prefer/Range headers, non-REST URLs or non-allow-listed RPCs.
+export const READ_ONLY_RPC = Object.freeze(["convergence_meter", "fn_method_value", "fn_number_dossier", "fn_number_journey", "fn_number_lookup",
+  "fn_zero_scale", "gematria_api", "gematria_method_trace", "get_category_videos", "number_neighbors", "posts_by_number_strict",
+  "world_group_source_arrivals_v2", "world_group_source_arrivals_v3"]);
+const norm = (u) => { try { return decodeURIComponent(u).replace(/([?&])apikey=[^&]*&?/, "$1").replace(/[?&]$/, ""); } catch { return u; } };
+
+export function createPublicTransport({ baseFetch, anonKey, noPreflight = false, early = false, dedupeRpc = false }) {
+  const base = baseFetch || ((...a) => fetch(...a));
+  const inflight = new Map();
+  const toRes = (e) => new Response(e.body.byteLength ? e.body.slice(0) : null, { status: e.status, statusText: e.statusText, headers: e.headers });
+  return function transport(input, init) {
+    const url = typeof input === "string" ? input : input instanceof URL ? input.href : input?.url;
+    const method = String(init?.method || (input instanceof Request ? input.method : "GET")).toUpperCase();
+    if (!url || !/\/rest\/v1\//.test(url)) return base(input, init);
+    const h = new Headers(init?.headers || (input instanceof Request ? input.headers : undefined));
+    const auth = h.get("authorization");
+    if (auth && auth !== `Bearer ${anonKey}`) return base(input, init);        // signed-in/unknown credential: untouched
+    if (method === "GET" && !h.get("prefer") && !h.get("range")) {
+      if (early && typeof window !== "undefined" && window.__sodEarly) {
+        const hit = window.__sodEarly.get(norm(url));
+        if (hit && (h.get("accept") || "application/json") === hit.accept) {
+          window.__sodEarly.delete(norm(url)); window.__earlyHits = (window.__earlyHits || 0) + 1;
+          return hit.p.then((r) => r || base(input, init), () => base(input, init));
+        }
+      }
+      const profile = h.get("accept-profile");   // supabase-js sends Accept-Profile: public for the default schema; it is not needed
+      if (noPreflight && h.get("apikey") === anonKey && (!profile || profile === "public") && !h.get("content-profile")) {
+        const u = new URL(url); u.searchParams.set("apikey", anonKey);
+        const accept = h.get("accept");
+        const { signal } = init || {};
+        return base(u.href, { method: "GET", signal, headers: accept && accept !== "*/*" ? { Accept: accept } : undefined });
+      }
+      return base(input, init);
+    }
+    if (dedupeRpc && method === "POST" && typeof init?.body === "string") {
+      const rpc = (url.match(/\/rpc\/([a-z0-9_]+)/) || [])[1];
+      if (rpc && READ_ONLY_RPC.includes(rpc)) {
+        const key = url + "\n" + init.body + "\n" + (h.get("authorization") || "");
+        let shared = inflight.get(key);
+        if (!shared) {
+          const { signal, ...rest } = init;
+          shared = (async () => { const res = await base(input, rest); const body = await res.arrayBuffer();
+            return { status: res.status, statusText: res.statusText, headers: [...res.headers.entries()], body }; })().finally(() => inflight.delete(key));
+          inflight.set(key, shared);
+        }
+        return shared.then(toRes);
+      }
+    }
+    return base(input, init);
+  };
+}
