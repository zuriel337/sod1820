+// The feed is secondary to the page's own content. It starts once the primary content has had the network
+// to itself (load + a short quiet window), or immediately on the first real interaction, so the panel and
+// the "new" chip are never withheld from someone who reaches for them. Reads, freshness and polling are unchanged.
+const QUIET_MS = 1500;
+export function afterPrimaryContent(start, { quietMs = QUIET_MS, win = typeof window === "undefined" ? null : window } = {}) {
+  if (!win) { start(); return () => {}; }
+  let done = false; let timer = null; let idle = null;
+  const events = ["pointerdown", "keydown", "touchstart", "wheel", "focusin"];
+  const cleanup = () => {
+    win.removeEventListener("load", arm);
+    events.forEach((name) => win.removeEventListener(name, go));
+    if (timer != null) win.clearTimeout(timer);
+    if (idle != null) win.cancelIdleCallback?.(idle);
+  };
+  const go = () => { if (done) return; done = true; cleanup(); start(); };
+  function arm() {
+    if (done) return;
+    timer = win.setTimeout(() => {
+      timer = null;
+      if (typeof win.requestIdleCallback === "function") idle = win.requestIdleCallback(go, { timeout: 2500 });
+      else go();
+    }, quietMs);
+  }
+  events.forEach((name) => win.addEventListener(name, go, { passive: true, once: true }));
+  if (win.document?.readyState === "complete") arm(); else win.addEventListener("load", arm, { once: true });
+  return () => { done = true; cleanup(); };
+}
