diff --git a/src/lib/scrollRestore2029.js b/src/lib/scrollRestore2029.js
new file mode 100644
index 00000000..e148fe8e
--- /dev/null
+++ b/src/lib/scrollRestore2029.js
@@ -0,0 +1,84 @@
+// Scroll safety net for the 2029 runtime (BrowserRouter has no <ScrollRestoration>).
+// The browser already restores the offset on back/forward when the document is tall enough early enough
+// (measured: Home after back). It fails when the page content arrives later (measured: World after
+// forward stayed at 0 instead of ~2750). This module leaves the browser in charge and only completes
+// a restore the browser did not do:
+//   - the offset of every history entry is remembered (session storage, bounded);
+//   - on back/forward (POP) with a remembered offset, wait (bounded) until the document is tall enough,
+//     then scroll DOWN to it if the browser left the page more than 40px above;
+//   - never scroll up, never fight the user (touch/wheel/key/pointer cancels), hash navigation untouched.
+export const SCROLL_STORE_KEY = 'sod2029-scroll-v1';
+export const SCROLL_STORE_MAX = 60;
+export const RESTORE_MAX_WAIT_MS = 4000;
+export const RESTORE_TOLERANCE_PX = 40;
+
+export function planNavigation({ navType, hash, saved }) {
+  if (hash) return { action: 'none' };
+  if (navType === 'POP' && Number.isFinite(saved) && saved > 0) return { action: 'restore', y: saved };
+  return { action: 'none' };
+}
+
+export function readStore(storage) {
+  try { const v = JSON.parse(storage.getItem(SCROLL_STORE_KEY) || '{}'); return v && typeof v === 'object' ? v : {}; } catch { return {}; }
+}
+export function trimStore(store, max = SCROLL_STORE_MAX) {
+  const keys = Object.keys(store);
+  if (keys.length <= max) return store;
+  return Object.fromEntries(keys.slice(keys.length - max).map((k) => [k, store[k]]));
+}
+
+export function createScrollRestorer2029(win = window) {
+  const store = readStore(win.sessionStorage || { getItem: () => null });
+  let currentKey = null, restoring = null, queued = false, stopListening = null, last = null;
+
+  const persist = () => { try { win.sessionStorage.setItem(SCROLL_STORE_KEY, JSON.stringify(trimStore(store))); } catch { /* storage may be blocked */ } };
+  const record = () => {
+    queued = false;
+    if (currentKey == null || restoring) return;
+    const y = Math.max(0, Math.round(win.scrollY || 0));
+    const h = win.document.documentElement.scrollHeight;
+    // When the page is swapped out the document shrinks and the browser clamps scrollY to the new maximum
+    // before the router's location key changes; that clamped value is not where the user was.
+    if (last && h < last.h - 1 && y < last.y && y >= h - win.innerHeight - 1) return;
+    last = { y, h };
+    delete store[currentKey]; store[currentKey] = y; // re-insert: most recent last, for trimming
+  };
+  const onScroll = () => { if (!queued) { queued = true; win.requestAnimationFrame(record); } };
+  const flush = () => { record(); persist(); };
+  const cancelRestore = () => { if (restoring) { restoring.cancel(); restoring = null; } };
+
+  function restore(y) {
+    cancelRestore();
+    const started = Date.now(); let done = false;
+    const inputs = ['touchstart', 'wheel', 'keydown', 'pointerdown'];
+    const finish = () => { if (done) return; done = true; inputs.forEach((e) => win.removeEventListener(e, finish)); if (restoring === handle) restoring = null; };
+    const handle = { cancel: finish };
+    restoring = handle;
+    inputs.forEach((e) => win.addEventListener(e, finish, { passive: true, once: true }));
+    const tick = () => {
+      if (done) return;
+      const reachable = win.document.documentElement.scrollHeight - win.innerHeight >= y - 1;
+      if (reachable) { if ((win.scrollY || 0) < y - RESTORE_TOLERANCE_PX) win.scrollTo(0, y); finish(); return; }
+      if (Date.now() - started > RESTORE_MAX_WAIT_MS) { finish(); return; }
+      win.requestAnimationFrame(tick);
+    };
+    win.requestAnimationFrame(tick);
+  }
+
+  return {
+    start() {
+      win.addEventListener('scroll', onScroll, { passive: true });
+      win.addEventListener('pagehide', flush);
+      stopListening = () => { win.removeEventListener('scroll', onScroll); win.removeEventListener('pagehide', flush); cancelRestore(); };
+    },
+    stop() { flush(); stopListening?.(); },
+    // call from a layout effect when the router location changes
+    onLocation({ key, hash, navType }) {
+      const plan = planNavigation({ navType, hash, saved: store[key] });
+      currentKey = key; last = null;
+      cancelRestore();
+      if (plan.action === 'restore') restore(plan.y);
+      return plan;
+    },
+  };
+}
