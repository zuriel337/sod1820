@@ -0,0 +1,90 @@
+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { planNavigation, trimStore, createScrollRestorer2029, SCROLL_STORE_KEY, RESTORE_MAX_WAIT_MS } from '../src/lib/scrollRestore2029.js';
+
+test('plan: only back/forward with a remembered offset restores; hash and everything else are left alone', () => {
+  assert.deepEqual(planNavigation({ navType: 'POP', hash: '', saved: 1800 }), { action: 'restore', y: 1800 });
+  assert.deepEqual(planNavigation({ navType: 'POP', hash: '#x', saved: 1800 }), { action: 'none' });
+  assert.deepEqual(planNavigation({ navType: 'POP', hash: '', saved: 0 }), { action: 'none' });
+  assert.deepEqual(planNavigation({ navType: 'POP', hash: '', saved: undefined }), { action: 'none' });
+  assert.deepEqual(planNavigation({ navType: 'PUSH', hash: '', saved: 500 }), { action: 'none' });
+  assert.deepEqual(planNavigation({ navType: 'REPLACE', hash: '', saved: 500 }), { action: 'none' });
+});
+test('store keeps the most recent entries', () => {
+  const s = Object.fromEntries(Array.from({ length: 70 }, (_, i) => [`k${i}`, i]));
+  const t = trimStore(s, 60);
+  assert.equal(Object.keys(t).length, 60); assert.equal(t.k69, 69); assert.equal(t.k0, undefined);
+});
+
+function fakeWindow({ height = 800 } = {}) {
+  const listeners = {}; let raf = []; const calls = [];
+  const win = {
+    scrollY: 0, innerHeight: 800, sessionStorage: { _: {}, getItem(k) { return this._[k] ?? null; }, setItem(k, v) { this._[k] = v; } },
+    document: { documentElement: { scrollHeight: height } },
+    addEventListener(e, f) { (listeners[e] ||= new Set()).add(f); }, removeEventListener(e, f) { listeners[e]?.delete(f); },
+    requestAnimationFrame(f) { raf.push(f); return raf.length; },
+    scrollTo(x, y) { calls.push(y); win.scrollY = y; },
+  };
+  return { win, calls, flushRaf: () => { const q = raf; raf = []; q.forEach((f) => f()); }, emit: (e) => [...(listeners[e] || [])].forEach((f) => f()) };
+}
+function leaveAndReturn(f, r, y) {
+  r.onLocation({ key: 'home', hash: '', navType: 'POP' });
+  f.win.scrollY = y; f.emit('scroll'); f.flushRaf();
+  r.onLocation({ key: 'post', hash: '', navType: 'PUSH' });
+}
+
+test('forward/back: waits until the document is tall enough, then scrolls down to the remembered offset', () => {
+  const f = fakeWindow({ height: 7000 }); const r = createScrollRestorer2029(f.win); r.start();
+  leaveAndReturn(f, r, 2750);
+  f.win.scrollY = 0; f.win.document.documentElement.scrollHeight = 900;   // browser could not restore, page still short
+  r.onLocation({ key: 'home', hash: '', navType: 'POP' });
+  f.flushRaf(); assert.equal(f.win.scrollY, 0);
+  f.win.document.documentElement.scrollHeight = 7000; f.flushRaf();
+  assert.equal(f.win.scrollY, 2750);
+});
+test('when the browser already restored the offset nothing is scrolled, and the page is never scrolled up', () => {
+  const f = fakeWindow({ height: 7000 }); const r = createScrollRestorer2029(f.win); r.start();
+  leaveAndReturn(f, r, 2000);
+  f.win.scrollY = 2000; const before = f.calls.length;
+  r.onLocation({ key: 'home', hash: '', navType: 'POP' }); f.flushRaf();
+  assert.equal(f.calls.length, before);
+  f.win.scrollY = 3500;                                                      // browser/user is further down than remembered
+  r.onLocation({ key: 'home', hash: '', navType: 'POP' }); f.flushRaf();
+  assert.equal(f.win.scrollY, 3500);
+});
+test('user input cancels a pending restore', () => {
+  const f = fakeWindow({ height: 900 }); const r = createScrollRestorer2029(f.win); r.start();
+  r.onLocation({ key: 'a', hash: '', navType: 'POP' });
+  f.win.scrollY = 1500; f.win.document.documentElement.scrollHeight = 7000; f.emit('scroll'); f.flushRaf();
+  r.onLocation({ key: 'b', hash: '', navType: 'PUSH' });
+  f.win.scrollY = 0; f.win.document.documentElement.scrollHeight = 900;
+  r.onLocation({ key: 'a', hash: '', navType: 'POP' });
+  f.emit('touchstart'); f.win.document.documentElement.scrollHeight = 7000; f.flushRaf();
+  assert.equal(f.win.scrollY, 0);
+});
+test('a restore that never becomes reachable gives up after the bounded wait without scrolling', () => {
+  const f = fakeWindow({ height: 7000 }); const r = createScrollRestorer2029(f.win); r.start();
+  leaveAndReturn(f, r, 3000);
+  f.win.scrollY = 0; f.win.document.documentElement.scrollHeight = 900;
+  const realNow = Date.now; let t = realNow(); Date.now = () => t;
+  try { r.onLocation({ key: 'home', hash: '', navType: 'POP' }); t += RESTORE_MAX_WAIT_MS + 10; f.flushRaf(); f.flushRaf(); } finally { Date.now = realNow; }
+  assert.equal(f.win.scrollY, 0);
+});
+test('a clamp caused by the page being swapped out is not recorded as the user position', () => {
+  const f = fakeWindow({ height: 7000 }); const r = createScrollRestorer2029(f.win); r.start();
+  r.onLocation({ key: 'home', hash: '', navType: 'POP' });
+  f.win.scrollY = 2114; f.emit('scroll'); f.flushRaf();
+  f.win.document.documentElement.scrollHeight = 880; f.win.scrollY = 80; f.emit('scroll'); f.flushRaf(); // clamp to the new maximum
+  r.onLocation({ key: 'post', hash: '', navType: 'PUSH' });
+  f.win.document.documentElement.scrollHeight = 7000; f.win.scrollY = 0;
+  r.onLocation({ key: 'home', hash: '', navType: 'POP' }); f.flushRaf();
+  assert.equal(f.win.scrollY, 2114);
+});
+test('hash navigation is untouched and positions persist for reloads', () => {
+  const f = fakeWindow(); const r = createScrollRestorer2029(f.win); r.start();
+  r.onLocation({ key: 'a', hash: '', navType: 'POP' });
+  r.onLocation({ key: 'b', hash: '#world-sources', navType: 'PUSH' });
+  assert.equal(f.calls.length, 0);
+  f.win.scrollY = 640; f.emit('scroll'); f.flushRaf(); r.stop();
+  assert.equal(JSON.parse(f.win.sessionStorage._[SCROLL_STORE_KEY]).b, 640);
+});
