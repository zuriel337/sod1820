diff --git a/src/components/experience2029/PersistentShell2029.jsx b/src/components/experience2029/PersistentShell2029.jsx
new file mode 100644
index 00000000..325394c8
--- /dev/null
+++ b/src/components/experience2029/PersistentShell2029.jsx
@@ -0,0 +1,42 @@
+// EXPERIMENT (A/B only, not integrated): one System Frame instance kept mounted across 2029 routes.
+// Pages keep calling <Sod2029Shell ...props>; inside this layout that component only registers its
+// props with the single frame and renders its children into the frame's content slot.
+import React, { Suspense, createContext, isValidElement, useCallback, useContext, useLayoutEffect, useMemo, useState } from "react";
+import { Outlet } from "react-router-dom";
+import SystemFrame2029 from "./SystemFrame2029.jsx";
+
+const PersistentShellContext = createContext(null);
+
+function shallowEqual(a, b) {
+  if (a === b) return true;
+  if (!a || !b) return false;
+  const ka = Object.keys(a);
+  if (ka.length !== Object.keys(b).length) return false;
+  return ka.every((k) => Object.is(a[k], b[k]) || sameValue(a[k], b[k]));
+}
+function sameValue(a, b) {
+  if (isValidElement(a) && isValidElement(b)) return a.type === b.type && shallowEqual(a.props, b.props);
+  return false;
+}
+
+export function PersistentShellLayout2029() {
+  const [frameProps, setFrameProps] = useState(null);
+  const register = useCallback((next) => setFrameProps((prev) => (shallowEqual(prev, next) ? prev : next)), []);
+  const value = useMemo(() => ({ register }), [register]);
+  return (
+    <PersistentShellContext.Provider value={value}>
+      <SystemFrame2029 {...(frameProps || {})}>
+        <Suspense fallback={<div role="status" style={{ minHeight: "40vh" }} aria-label="טוען" />}>
+          <Outlet />
+        </Suspense>
+      </SystemFrame2029>
+    </PersistentShellContext.Provider>
+  );
+}
+
+export default function Sod2029ShellSlot(props) {
+  const ctx = useContext(PersistentShellContext);
+  const { children, ...rest } = props;
+  useLayoutEffect(() => { ctx?.register(rest); });
+  return ctx ? <>{children}</> : <SystemFrame2029 {...props} />;
+}
