--- a/src/components/experience2029/systemFrame2029.css
+++ b/src/components/experience2029/systemFrame2029.css
@@ -74,7 +74,6 @@
 /* One transient surface at a time. Keep canonical context above global supplemental hints (PlaneHintSpotlight=1800) and below true full-screen media/lightbox layers (2000+). */
 .sod29-frame-backdrop{position:fixed;inset:0;z-index:1900;background:color-mix(in srgb,var(--s29-page) 58%,transparent);backdrop-filter:blur(8px);display:flex;align-items:stretch;justify-content:flex-start;padding:10px}
 .sod29-frame-panel{margin-inline-start:auto;width:min(var(--s29-sidecar-width,520px),100%);height:calc(100vh - 20px);overflow:auto;border:1px solid var(--s29-line-strong);border-radius:26px;background:color-mix(in srgb,var(--s29-panel) 98%,transparent);color:var(--s29-ink);box-shadow:0 36px 120px color-mix(in srgb,var(--s29-page) 62%,transparent);display:flex;flex-direction:column}
-[dir="ltr"] .sod29-frame-panel{margin-inline-start:0;margin-inline-end:auto}
 .sod29-frame-panel-head{position:sticky;top:0;z-index:3;display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 16px;border-bottom:1px solid var(--s29-line);background:color-mix(in srgb,var(--s29-panel) 96%,transparent);backdrop-filter:blur(16px)}
 .sod29-frame-panel-title{display:flex;align-items:center;gap:10px;min-width:0}.sod29-frame-panel-title small{display:block;color:var(--s29-muted);font-size:var(--s29-type-micro);font-weight:800;letter-spacing:.1em}.sod29-frame-panel-title strong{display:block;margin-top:2px;font-size:16px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.sod29-frame-panel-icon{width:38px;height:38px;display:grid;place-items:center;border:1px solid var(--s29-line);border-radius:13px;color:var(--s29-accent-text);background:color-mix(in srgb,var(--s29-accent) 7%,transparent);font-weight:900}
 .sod29-frame-panel-head>button{width:44px;height:44px;border:1px solid var(--s29-line);border-radius:12px;background:transparent;color:var(--s29-ink);cursor:pointer;font-size:22px}
