@@ -0,0 +1,62 @@
+// EXPERIMENT (OLD_POST_ARTICLE_FIRST_20261116, scratch worktree only): the article of an imported Post for the FIRST document, built by the
+// client's own functions (postArticleCore2029.js + hardenPassiveMediaHtml + the title and date helpers). The page adopts these nodes instead of
+// rendering the article a second time (Post2029Page experiment patch). Needs a DOM: the browser's, or a server DOM passed in (lab: happy-dom).
+import { postReadingHtml2029, markLegacyEqualityLines } from "./postArticleCore2029.js";
+import { hardenPassiveMediaHtml } from "../mediaEgressGuard.js";
+import { humanContentTitle } from "../presentation/contentTitle.js";
+import { bilingualDateLabel } from "../relativeTime2029.js";
+
+export const POST_ARTICLE_DOCUMENT_ID = "sod29-ssr-article";
+
+// The identity of the source the article was built from: FNV-1a over the raw stored content, plus its length.
+export function postArticleSourceKey2029(content) {
+  let hash = 0x811c9dc5; const text = String(content || "");
+  for (let index = 0; index < text.length; index += 1) { hash ^= text.charCodeAt(index); hash = Math.imul(hash, 0x01000193) >>> 0; }
+  return `${hash.toString(16).padStart(8, "0")}:${text.length}`;
+}
+
+// Exactly the page's pipeline for an ordinary imported Post: projection (markLegacyEqualityLines) -> postReadingHtml2029 -> hardenPassiveMediaHtml.
+export function postArticleBodyHtml2029(content) {
+  return hardenPassiveMediaHtml(postReadingHtml2029(markLegacyEqualityLines(content)));
+}
+
+const escapeHtml = value => String(value ?? "").replace(/[&<>"']/g, char => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);
+
+// The page's duplicate-cover rule (Post2029Page effect), applied to the same body.
+function markDuplicateCover(template, imageUrl) {
+  const cover = String(imageUrl || "").trim().split("?")[0];
+  if (!cover) return;
+  const first = template.content.querySelector("img");
+  if (!first || (first.getAttribute("src") || "").trim().split("?")[0] !== cover) return;
+  const parent = first.parentElement;
+  const wrap = parent && parent.children.length === 1 && !parent.textContent.trim() ? parent : first;
+  wrap.setAttribute("data-duplicate-cover", "true");
+}
+
+export function postArticleDocumentHtml2029(post, { document = globalThis.document } = {}) {
+  const template = document.createElement("template");
+  template.innerHTML = postArticleBodyHtml2029(post.content);
+  markDuplicateCover(template, post.image_url);
+  const title = humanContentTitle(post.title, { max: 0 });
+  const date = String(post.date || post.modified || "").slice(0, 10);
+  const author = String(post.author || "").trim();
+  const cover = typeof post.image_url === "string" ? post.image_url.trim() : "";
+  return `<article id="${POST_ARTICLE_DOCUMENT_ID}" class="sod29-ssr-article" dir="rtl" data-ssr-post="${escapeHtml(post.id)}" data-ssr-source="${postArticleSourceKey2029(post.content)}">`
+    + `<header class="sod29-ssr-head"><h1>${escapeHtml(title)}</h1>`
+    + `<p class="sod29-ssr-byline">${author ? `ייחוס במקור: ${escapeHtml(author)} · ` : ""}${date ? `<time datetime="${escapeHtml(date)}">${escapeHtml(bilingualDateLabel(date, date))}</time>` : ""}</p></header>`
+    + (cover ? `<figure class="sod29-ssr-cover"><img src="${escapeHtml(cover)}" alt="" fetchpriority="high" decoding="async"></figure>` : "")
+    + `<section class="sod29-ssr-source" aria-label="טקסט המקור">${template.innerHTML}</section>`
+    + `</article>`;
+}
+
+// What the first document needs so the app's own first frames never push the article down: the app root keeps the opening bar's
+// height while the document article is present (CSS only, :has), and a reading column close to the page's.
+export const POST_ARTICLE_DOCUMENT_STYLE = `<style>
+html:has(#${POST_ARTICLE_DOCUMENT_ID}) #root{height:var(--sod29-ssr-root,132px);overflow:hidden}
+.sod29-ssr-article{display:block;max-width:760px;margin:0 auto;padding:8px 16px 48px;color:#f5f0e8;font-family:'Noto Sans Hebrew','Rubik',Arial,sans-serif;line-height:1.85;font-size:17px}
+.sod29-ssr-head h1{font-size:clamp(24px,6vw,36px);line-height:1.3;margin:12px 0 6px;color:#fff3c4}
+.sod29-ssr-byline{margin:0 0 14px;color:#c9bfae;font-size:14px}
+.sod29-ssr-cover{margin:0 auto 20px;width:min(100%,560px);aspect-ratio:1586/992;max-height:min(46vh,360px)}.sod29-ssr-cover img{display:block;width:100%;height:100%;object-fit:contain;border-radius:14px}
+.sod29-ssr-source img{max-width:100%;height:auto}.sod29-ssr-source [data-duplicate-cover="true"]{display:none}
+.sod29-ssr-source iframe{max-width:100%}
+</style>`;
