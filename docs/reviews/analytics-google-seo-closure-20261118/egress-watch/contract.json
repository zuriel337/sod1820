{
  "name": "SOD1820 Egress Watch — hourly observed Storage egress",
  "owner": "traffic_intelligence_law v11",
  "producer_automation_id": "6aba26ab34f48191b0d49c958b37df6d",
  "producer_actor": "GPT (ChatGPT automation; not in this repository, not in the database)",
  "schedule": "hourly; one row per completed UTC hour; no backfill with a current computed_at",
  "cache_key_pattern": "^infra_egress_hour:\\d{4}-\\d{2}-\\d{2}T\\d{2}:00:00Z$",
  "row": { "producer": "traffic_intelligence_law", "producer_version": "v11" },
  "readers": ["public.admin_system_health (payload->>'storage_get_bytes', computed_at)", "public.fn_health_watch (sensor_stale, warn/critical)"],
  "required": {
    "storage_get_bytes": "integer>=0",
    "storage_get_requests": "integer>=0",
    "basis": "OBSERVED_STORAGE_LOGS",
    "window_start": "iso-hour",
    "window_end": "iso-hour",
    "collection_version": "string",
    "producer_automation_id": "string",
    "provider_cached_egress_basis": "UNKNOWN|EXACT|ESTIMATED",
    "risk.level": "OK|WARN|CRITICAL",
    "risk.warn_reasons": "array",
    "risk.critical_reasons": "array",
    "risk.mp4_burst.client_identifiers_persisted": "false",
    "coverage.rolling_24h_status": "COMPLETE|PARTIAL",
    "coverage.missing_hours_24h": "integer>=0",
    "coverage.rolling_24h_missing_hours": "array",
    "buckets.media_bytes": "integer>=0",
    "buckets.gallery_bytes": "integer>=0",
    "traffic_classes.bot_bytes": "integer>=0",
    "traffic_classes.human_or_browser_bytes": "integer>=0",
    "traffic_classes.unknown_bytes": "integer>=0"
  },
  "forbidden_anywhere": ["ip", "client_ip", "user_agent", "visitor_id", "email", "object_path", "filename"],
  "also_writes": "infra_media_dedupe_snapshot:<YYYY-MM-DD> (candidate duplicate groups; safe_to_delete=false)"
}
