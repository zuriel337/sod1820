+import test from "node:test";
+import assert from "node:assert/strict";
+import {assertPublicationConfig,readPublicationConfig,assertMainReleaseContract} from "../scripts/test-public-reading-main-release-contract.mjs";
+import {protectedReviewBuildIdentity,protectedReviewRuntimeAuthorized,publicCandidateBuildIdentity,publicCandidateRuntimeAuthorized,REVIEW_PROJECT_ID,REVIEW_BRANCH,PRODUCTION_REVIEW_BRANCH} from "../public-reading-deploy/review-admission.js";
+const sha="a".repeat(40);
+const fixture=(target,branch)=>({VERCEL:"1",VERCEL_ENV:target,VERCEL_TARGET_ENV:target,VERCEL_PROJECT_ID:REVIEW_PROJECT_ID,VERCEL_GIT_COMMIT_REF:branch,VERCEL_GIT_COMMIT_SHA:sha,VERCEL_DEPLOYMENT_ID:"dpl_SyntheticMainRelease1",VERCEL_URL:"sod1820-syntheticmain1-sod1820-s-projects.vercel.app"});
+const input=env=>({env,sourceSha:sha,sourceDirty:false,requestedSourceSha:sha});
+test("current publication and fallback are different explicit artifacts",()=>assert.equal(assertMainReleaseContract(),true));
+const changes={"fallback Git deployment true":v=>v.fallback.git.deploymentEnabled=true,"fallback Git setting removed":v=>delete v.fallback.git,"publication Git deployment true":v=>v.publication.git.deploymentEnabled=true,"publication Git setting removed":v=>delete v.publication.git,"public document bypass":v=>v.publication.rewrites.at(-1).destination="/index.html","robots missing":v=>v.publication.rewrites=v.publication.rewrites.filter(x=>x.source!=="/robots.txt"),"sitemap missing":v=>v.publication.rewrites=v.publication.rewrites.filter(x=>x.source!=="/sitemap.xml"),"raw document bypass":v=>v.publication.rewrites.find(x=>x.source==="/2029.html").destination="/2029.html","template missing":v=>delete v.publication.functions,"worker cache unsafe":v=>v.publication.headers=v.publication.headers.filter(x=>!x.source.includes("sw.js")),"fallback shared flag enabled":v=>v.launch=v.launch.replace("CORE_PUBLIC_LAUNCH_2029 = false","CORE_PUBLIC_LAUNCH_2029 = true"),"compiler activation check removed":v=>v.builder=v.builder.replace("public_reading_hosted_activation_requires_separate_guard_approval","")};
+for(const [name,change] of Object.entries(changes))test("reject "+name,()=>{const v=structuredClone(readPublicationConfig());change(v);assert.throws(()=>assertPublicationConfig(v))});
+test("main is an exact manual candidate, not deployment authorization",()=>{const env=fixture("production",PRODUCTION_REVIEW_BRANCH),r=publicCandidateBuildIdentity(input(env));assert.equal(r.branch,"main");assert.equal(r.productionAuthorized,false);assert.equal(r.cutoverAuthorized,false);assert.equal(r.domainAssignmentAuthorized,false);assert.equal(publicCandidateRuntimeAuthorized(r,env),true);assert.equal(publicCandidateRuntimeAuthorized(r,{...env,VERCEL_GIT_COMMIT_REF:REVIEW_BRANCH}),false)});
+test("current integration Preview remains protected and cannot impersonate Production",()=>{const env=fixture("preview",REVIEW_BRANCH),r=protectedReviewBuildIdentity(input(env));assert.equal(r.productionAuthorized,false);assert.equal(r.indexingAuthorized,false);assert.equal(protectedReviewRuntimeAuthorized(r,env),true);assert.equal(protectedReviewRuntimeAuthorized(r,fixture("production","main")),false)});
+for(const branch of ["gpt/2029-public-cutover-final-preparation-20261103","ccr-75c9c441-4gdlnu","gpt/2029-membership-credit-meter-ui-20261101","claude/old-session","codex/ahavat-preview-open-20261031","ccr-c26b4a83-a0e6to"])
+ test("retired branch rejected: "+branch,()=>{assert.throws(()=>publicCandidateBuildIdentity(input(fixture("production",branch))),/identity_rejected/);assert.throws(()=>protectedReviewBuildIdentity(input(fixture("preview",branch))),/identity_rejected/)});
